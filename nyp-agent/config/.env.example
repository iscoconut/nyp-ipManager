# nyp-agent 环境配置

# API 监听地址 (默认: 127.0.0.1)
# 如果需要远程访问，改为 0.0.0.0
API_HOST=127.0.0.1

# API 监听端口 (默认: 3000)
API_PORT=3000

# API Token (可选，留空则不验证)
# API_TOKEN=your-secret-token

# 配置文件路径 (默认: ../config/config.json)
# CONFIG_PATH=/opt/nyp-agent/config/config.json

# 启动时是否自动开始监控 (默认: true)
# AUTO_START=true
