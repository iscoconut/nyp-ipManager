[Unit]
Description=nyp-agent IP Failover Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nyp-agent
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

# 环境变量
Environment=NODE_ENV=production
Environment=CONFIG_PATH=/opt/nyp-agent/config/config.json
Environment=API_PORT=3000
#Environment=API_TOKEN=your-secret-token

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nyp-agent

[Install]
WantedBy=multi-user.target
